library(drones4health)
library(ggplot2)
library(tidyterra)
library(sf)
library(terra)
# 1. Rutas
dir_img <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
img_rgb <- file.path(dir_img, "Ohuay_D.tif")
img_nir <- file.path(dir_img, "Ohuay_NIR.tif")
img_r   <- file.path(dir_img, "Ohuay_R.tif")
# 2. Índice NDVI
r_ndvi  <- d4h_ndvi(nir = img_nir, red = img_r)
# ==============================================================================
# PASO 1: DETECCIÓN CALIBRADA DE TODAS LAS VIVIENDAS (480 detectadas)
# ==============================================================================
viviendas <- d4h_segment_buildings(
rgb_raster     = img_rgb,
brightness_min = 135.0,
min_area_m2    = 12.0,
max_area_m2    = 600.0,
method         = "spectral"
)
cat("Total de viviendas detectadas en todo el vuelo:", nrow(viviendas), "\n")
# ==============================================================================
# PASO 2: DETECCIÓN DE AGUA PURA CON FILTRO ÓPTICO DE OSCURIDAD
# ==============================================================================
cuerpos_agua <- d4h_segment_water(
raster_in            = r_ndvi,
rgb_raster           = img_rgb,
max_water_brightness = 90.0,      # El agua real es oscura; descarta calaminas y concreto
threshold            = -0.15,
min_area_m2          = 15.0,
exclude_buildings    = viviendas  # Exclusión espacial estricta de viviendas
)
cat("Cuerpos de agua reales filtrados:", nrow(cuerpos_agua), "\n")
# ==============================================================================
# PASO 3: MATRIZ DE RIESGO ONE HEALTH
# ==============================================================================
viviendas_riesgo <- d4h_distance_to_risk(
buildings    = viviendas,
sources      = cuerpos_agua,
decay_lambda = 100.0
)
# ==============================================================================
# PASO 4: MAPA GENERAL (Polígonos Limpios sin Centroides)
# ==============================================================================
r_global <- terra::aggregate(terra::rast(img_rgb), fact = 15)
p_general <- ggplot() +
geom_spatraster_rgb(data = r_global, r = 1, g = 2, b = 3, max_col_value = 255) +
geom_sf(data = cuerpos_agua, fill = "#00e5ff", color = "#005082", alpha = 0.6, linewidth = 0.2) +
geom_sf(data = viviendas_riesgo, aes(fill = risk_level), color = "black", linewidth = 0.3, alpha = 0.85) +
scale_fill_manual(
name = "Riesgo Epidemiológico",
values = c(
"Crítico (<50m)"      = "#d73027",
"Alto (50-100m)"      = "#fc8d59",
"Moderado (100-200m)" = "#fee08b",
"Bajo (>200m)"        = "#91cf60"
)
) +
labs(
title = paste0("Mapa GeoAI One Health: Vuelo Ohuay (", nrow(viviendas_riesgo), " viviendas)"),
subtitle = paste0(nrow(cuerpos_agua), " criaderos de agua identificados"),
caption = "Drones4Health Framework"
) +
theme_minimal() +
theme(
legend.position = "right",
plot.title = element_text(face = "bold", size = 14)
)
print(p_general)
library(drones4health)
library(ggplot2)
library(tidyterra)
library(sf)
library(terra)
# 1. Rutas
dir_img <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
img_rgb <- file.path(dir_img, "Ohuay_D.tif")
img_nir <- file.path(dir_img, "Ohuay_NIR.tif")
img_r   <- file.path(dir_img, "Ohuay_R.tif")
# 2. Índice NDVI
r_ndvi  <- d4h_ndvi(nir = img_nir, red = img_r)
# ==============================================================================
# PASO 1: DETECCIÓN CALIBRADA DE TODAS LAS VIVIENDAS (480 detectadas)
# ==============================================================================
viviendas <- d4h_segment_buildings(
rgb_raster     = img_rgb,
brightness_min = 135.0,
min_area_m2    = 12.0,
max_area_m2    = 600.0,
method         = "sam"
)
cat("Total de viviendas detectadas en todo el vuelo:", nrow(viviendas), "\n")
# ==============================================================================
# PASO 2: DETECCIÓN DE AGUA PURA CON FILTRO ÓPTICO DE OSCURIDAD
# ==============================================================================
cuerpos_agua <- d4h_segment_water(
raster_in            = r_ndvi,
rgb_raster           = img_rgb,
max_water_brightness = 90.0,      # El agua real es oscura; descarta calaminas y concreto
threshold            = -0.15,
min_area_m2          = 15.0,
exclude_buildings    = viviendas  # Exclusión espacial estricta de viviendas
)
cat("Cuerpos de agua reales filtrados:", nrow(cuerpos_agua), "\n")
# ==============================================================================
# PASO 3: MATRIZ DE RIESGO ONE HEALTH
# ==============================================================================
viviendas_riesgo <- d4h_distance_to_risk(
buildings    = viviendas,
sources      = cuerpos_agua,
decay_lambda = 100.0
)
# ==============================================================================
# PASO 4: MAPA GENERAL (Polígonos Limpios sin Centroides)
# ==============================================================================
r_global <- terra::aggregate(terra::rast(img_rgb), fact = 15)
p_general <- ggplot() +
geom_spatraster_rgb(data = r_global, r = 1, g = 2, b = 3, max_col_value = 255) +
geom_sf(data = cuerpos_agua, fill = "#00e5ff", color = "#005082", alpha = 0.6, linewidth = 0.2) +
geom_sf(data = viviendas_riesgo, aes(fill = risk_level), color = "black", linewidth = 0.3, alpha = 0.85) +
scale_fill_manual(
name = "Riesgo Epidemiológico",
values = c(
"Crítico (<50m)"      = "#d73027",
"Alto (50-100m)"      = "#fc8d59",
"Moderado (100-200m)" = "#fee08b",
"Bajo (>200m)"        = "#91cf60"
)
) +
labs(
title = paste0("Mapa GeoAI One Health: Vuelo Ohuay (", nrow(viviendas_riesgo), " viviendas)"),
subtitle = paste0(nrow(cuerpos_agua), " criaderos de agua identificados"),
caption = "Drones4Health Framework"
) +
theme_minimal() +
theme(
legend.position = "right",
plot.title = element_text(face = "bold", size = 14)
)
print(p_general)
