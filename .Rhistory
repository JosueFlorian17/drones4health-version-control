library(land4healthdemo2)
library(terra)
# 1. Definición de rutas
dir_img  <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
path_nir <- file.path(dir_img, "Ohuay_NIR.tif")
path_r   <- file.path(dir_img, "Ohuay_R.tif")
# 2. Generación directa de rásteres continuos limpios con las funciones
r_ndvi <- d4h_ndvi(path_nir, path_r)
r_savi <- d4h_savi(path_nir, path_r)
# 3. Generación directa de mallas hexagonales (50m) con las mismas funciones
hex_ndvi <- d4h_ndvi(path_nir, path_r, tamano_celda = 50, square = FALSE)
hex_savi <- d4h_savi(path_nir, path_r, tamano_celda = 50, square = FALSE)
# 4. Visualización de los rásteres continuos sin el marco exterior verde
par(mfrow = c(1, 2))
plot(
r_ndvi,
col = terrain.colors(50),
colNA = "white",
range = c(0, 0.8),
main = "d4h_ndvi Continuo (Corregido)"
)
plot(
r_savi,
col = rev(terrain.colors(50)),
colNA = "white",
range = c(0, 0.6),
main = "d4h_savi Continuo"
)
par(mfrow = c(1, 1))
# 5. Visualización de los hexágonos agregados de 50 m
par(mfrow = c(1, 2))
terra::plot(hex_ndvi, "NDVI", main = "NDVI Hexagonal (50m)", col = terrain.colors(30))
terra::plot(hex_savi, "SAVI", main = "SAVI Hexagonal (50m)", col = rev(terrain.colors(30)))
par(mfrow = c(1, 1))
# Ráster continuo de fondo con los bordes de los hexágonos superpuestos
par(mfrow = c(1, 2))
# NDVI continuo + bordes
plot(r_ndvi, col = terrain.colors(50), colNA = "white", range = c(0, 0.8),
main = "NDVI Continuo + Malla Hexagonal")
lines(hex_ndvi, col = "black", lwd = 0.5)
# SAVI continuo + bordes
plot(r_savi, col = rev(terrain.colors(50)), colNA = "white", range = c(0, 0.6),
main = "SAVI Continuo + Malla Hexagonal")
lines(hex_savi, col = "black", lwd = 0.5)
par(mfrow = c(1, 1))
par(mfrow = c(1, 2))
# Paleta viridis (resalta vigor biológico y humedad)
plot(r_ndvi, col = hcl.colors(50, "Viridis"), colNA = "white", range = c(0, 0.8),
main = "NDVI (Paleta Viridis)")
# Paleta magma / plasma (resalta contraste térmico o suelo árido)
plot(r_savi, col = hcl.colors(50, "YlOrRd"), colNA = "white", range = c(0, 0.6),
main = "SAVI (Paleta YlOrRd)")
par(mfrow = c(1, 1))
library(terra)
# Cargar el GeoTIFF multicapa continuo
dir_out   <- "C:/Users/Florian/Downloads/drone4health/drone4health/img/salidas"
r_indices <- rast(file.path(dir_out, "Ohuay_NDVI_SAVI.tif"))
# Visualización lado a lado exclusivamente de las capas ráster
par(mfrow = c(1, 2))
# 1. NDVI continuo puro
plot(
r_indices[["NDVI"]],
col   = terrain.colors(50),
colNA = "white",
range = c(0, 0.8),
main  = "NDVI Continuo (Raster)"
)
# 2. SAVI continuo puro
plot(
r_indices[["SAVI"]],
col   = rev(terrain.colors(50)),
colNA = "white",
range = c(0, 0.6),
main  = "SAVI Continuo (Raster)"
)
# Restaurar panel gráfico
par(mfrow = c(1, 1))
