library(drones4health)
library(terra)
# 1. Definir rutas reales de Ohuay
dir_img  <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
path_nir <- file.path(dir_img, "Ohuay_NIR.tif")
path_r   <- file.path(dir_img, "Ohuay_R.tif")
path_re  <- file.path(dir_img, "Ohuay_RE.tif")
path_dem <- file.path(dir_img, "Ohuay_D.tif")
# 2. Calcular los indicadores base
r_ndvi  <- d4h_ndvi(path_nir, path_r)
r_savi  <- d4h_savi(path_nir, path_r)
r_imsr  <- d4h_imsr(red_edge = path_re, red = path_r, nir = path_nir)
r_slope <- d4h_slope(path_dem, unit = "degrees")
# 3. Generar la grilla hexagonal operativa de 50 m
grid_hex <- d4h_hex_grid(r_ndvi, cell_size = 50)
swipe_ndvi_savi <- d4h_mapview_swipe(
x = r_ndvi,
y = r_savi,
grid = grid_hex,
col_x = "viridis",
col_y = "terrain",
max_pixels = 300000
)
library(terra)
# Submuestrear ligeramente para fluidez interactiva
r_ndvi_sub <- terra::aggregate(r_ndvi, fact = 4, fun = "mean", na.rm = TRUE)
r_savi_sub <- terra::aggregate(r_savi, fact = 4, fun = "mean", na.rm = TRUE)
# Visor interactivo nativo con selector de capas y fondo satelital
m <- plet(r_ndvi_sub, col = viridisLite::viridis(50), tiles = "Esri.WorldImagery")
m <- lines(m, grid_hex, col = "black", lwd = 1)
m
# 1. Instalar leaflet.extras2 si no está instalado
if (!requireNamespace("leaflet.extras2", quietly = TRUE)) install.packages("leaflet.extras2")
library(terra)
library(leaflet)
library(leaflet.extras2)
# 2. Submuestrear y proyectar a Web Mercator (EPSG:3857) para máxima fluidez
r_ndvi_3857 <- terra::project(terra::aggregate(r_ndvi, fact = 4, fun = "mean", na.rm = TRUE), "EPSG:3857")
r_savi_3857 <- terra::project(terra::aggregate(r_savi, fact = 4, fun = "mean", na.rm = TRUE), "EPSG:3857")
# Convertir la grilla a WGS84 para Leaflet
grid_wgs84 <- terra::project(grid_hex, "EPSG:4326")
# 3. Paletas de colores
pal_ndvi <- colorNumeric("viridis", domain = c(0, 0.8), na.color = "transparent")
pal_savi <- colorNumeric("magma", domain = c(0, 0.6), na.color = "transparent")
# 4. Crear el mapa Leaflet con la barra deslizadora Side-by-Side
m_swipe <- leaflet() %>%
addProviderTiles(providers$Esri.WorldImagery, group = "Satelite") %>%
# Capa Izquierda (NDVI)
addRasterImage(r_ndvi_3857, colors = pal_ndvi, opacity = 0.85,
group = "NDVI", layerId = "layer_left") %>%
# Capa Derecha (SAVI)
addRasterImage(r_savi_3857, colors = pal_savi, opacity = 0.85,
group = "SAVI", layerId = "layer_right") %>%
# Grilla hexagonal superpuesta (opcional)
addPolygons(data = sf::st_as_sf(grid_wgs84), fill = FALSE,
color = "black", weight = 1, opacity = 0.7) %>%
# Activar barra de deslizamiento vertical interactiva
addSideBySide(layerId = "sidebyside", leftId = "layer_left", rightId = "layer_right") %>%
# Leyendas
addLegend(pal = pal_ndvi, values = c(0, 0.8), title = "NDVI (Izq)", position = "bottomleft") %>%
addLegend(pal = pal_savi, values = c(0, 0.6), title = "SAVI (Der)", position = "bottomright")
library(terra)[cite: 30]
library(terra)[cite: 30]
library(terra)
library(leaflet)
library(leaflet.extras2)
r_ndvi_3857 <- terra::project(terra::aggregate(r_ndvi, fact = 4, fun = "mean", na.rm = TRUE), "EPSG:3857")
r_savi_3857 <- terra::project(terra::aggregate(r_savi, fact = 4, fun = "mean", na.rm = TRUE), "EPSG:3857")
# Convertir la grilla a WGS84 para Leaflet
grid_wgs84 <- terra::project(grid_hex, "EPSG:4326")
# 2. Paletas de colores
pal_ndvi <- colorNumeric("viridis", domain = c(0, 0.8), na.color = "transparent")
pal_savi <- colorNumeric("magma", domain = c(0, 0.6), na.color = "transparent")
# 3. Crear el mapa Leaflet con la barra deslizadora Side-by-side corregida
m_swipe <- leaflet() %>%
addProviderTiles(providers$Esri.WorldImagery, group = "Satelite") %>%
# Capa Izquierda (NDVI)
addRasterImage(r_ndvi_3857, colors = pal_ndvi, opacity = 0.85,
group = "NDVI", layerId = "layer_left") %>%
# Capa Derecha (SAVI)
addRasterImage(r_savi_3857, colors = pal_savi, opacity = 0.85,
group = "SAVI", layerId = "layer_right") %>%
# Grilla hexagonal superpuesta
addPolygons(data = sf::st_as_sf(grid_wgs84), fill = FALSE,
color = "black", weight = 1, opacity = 0.7) %>%
# Barra divisoria (nótese la 'b' minúscula en addSidebyside)
leaflet.extras2::addSidebyside(layerId = "sidebyside", leftId = "layer_left", rightId = "layer_right") %>%
# Leyendas
addLegend(pal = pal_ndvi, values = c(0, 0.8), title = "NDVI (Izq)", position = "bottomleft") %>%
addLegend(pal = pal_savi, values = c(0, 0.6), title = "SAVI (Der)", position = "bottomright")
