# 2. Rutas a los ortomosaicos validados de Ohuay
dir_img  <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
path_nir <- file.path(dir_img, "Ohuay_NIR.tif")
path_r   <- file.path(dir_img, "Ohuay_R.tif")
path_re  <- file.path(dir_img, "Ohuay_RE.tif")
path_dem <- file.path(dir_img, "Ohuay_D.tif")
dir_out  <- file.path(dir_img, "salidas")
if (!dir.exists(dir_out)) dir.create(dir_out, recursive = TRUE)
# 3. Cálculo de indicadores sobre la extensión común
r_ndvi  <- d4h_ndvi(path_nir, path_r)
r_savi  <- d4h_savi(path_nir, path_r, l_factor = 0.5)
r_ndre  <- d4h_ndre(path_nir, path_re)
r_imsr  <- d4h_imsr(red_edge = path_re, red = path_r, nir = path_nir)
