library(land4healthdemo2)
library(terra)
library(ggplot2)
dir_img  <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
path_nir <- file.path(dir_img, "Ohuay_NIR.tif")
path_r   <- file.path(dir_img, "Ohuay_R.tif")
ndvi_gen <- d4h_ndvi_general(path_nir, path_r)
d4h_plot(ndvi_gen, paleta = "viridis", limites = c(0, 0.8), titulo = "NDVI General Continuo (Fondo Limpio)")
# Comprobar si existen ceros de relleno o valores artificiales
vals <- terra::values(ndvi_gen, mat = FALSE)
cat("Conteo de NAs:", sum(is.na(vals)), "\n")
cat("Conteo de ceros exactos:", sum(vals == 0, na.rm = TRUE), "\n")
cat("Rango de valores:", range(vals, na.rm = TRUE), "\n")
cat("Cuantiles bajos (0% al 5%):\n")
print(quantile(vals, probs = seq(0, 0.05, 0.01), na.rm = TRUE))
