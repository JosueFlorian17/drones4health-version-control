library(land4healthdemo2)
library(terra)
library(ggplot2)
dir_img  <- "C:/Users/Florian/Downloads/drone4health/drone4health/img"
path_nir <- file.path(dir_img, "Ohuay_NIR.tif")
path_r   <- file.path(dir_img, "Ohuay_R.tif")
ndvi_gen <- d4h_ndvi_general(path_nir, path_r)
savi_gen <- d4h_savi_general(path_nir, path_r)
hex_50 <- d4h_ndvi(path_nir, path_r, tamano_celda = 50, square = FALSE)
d4h_plot(ndvi_gen, paleta = "viridis", limites = c(0, 0.8), titulo = "NDVI General Continuo")
d4h_plot(ndvi_gen, grilla = hex_50, paleta = "terrain", limites = c(0, 0.8), titulo = "NDVI con Malla Hexagonal")
d4h_plot(hex_50, paleta = "magma", titulo = "Grilla Hexagonal (50m)")
d4h_plot(ndvi_gen, paleta = "magma")
