library(drones4health)
library(terra)
library(ggplot2)
# 1. Normalizar las bandas reflectivas a [0, 1]
nir_norm <- d4h_normalize_reflectance(path_nir)
red_norm <- d4h_normalize_reflectance(path_r)
g_norm   <- d4h_normalize_reflectance(path_g)
# 2. Recalcular índices con datos calibrados
r_ndwi_cal  <- d4h_ndwi(g_norm, nir_norm)
r_gndvi_cal <- d4h_gndvi(nir_norm, g_norm)
r_dvi_cal   <- d4h_dvi(nir_norm, red_norm)
# 3. Tratar la banda térmica (RGB a escala de grises relativa 0-1)
# Tomamos una sola capa (Ohuay_T_1) y la normalizamos de 0 a 1
r_t_layer <- terra::rast(path_t)[[1]]
r_t_layer[r_t_layer == 0 | r_t_layer == 255] <- NA
r_t_rel <- r_t_layer / 255
names(r_t_rel) <- "T_Relativa"
cat("Celdas válidas en NDWI: ", terra::global(!is.na(r_ndwi_cal), "sum")[, 1], "\n")
cat("Celdas válidas en GNDVI:", terra::global(!is.na(r_gndvi_cal), "sum")[, 1], "\n")
cat("Rango real NDWI:        ", terra::minmax(r_ndwi_cal), "\n")
cat("Rango real GNDVI:       ", terra::minmax(r_gndvi_cal), "\n")
cat("Rango real DVI:         ", terra::minmax(r_dvi_cal), "\n")
cat("Rango real Térmico Rel: ", terra::minmax(r_t_rel), "\n")
# Índices espectrales (paleta viridis estándar)
p_ndwi <- d4h_plot(r_ndwi_cal, palette = "viridis", limits = c(-0.6, 0.4),
title = "NDWI Continuo (Agua y Humedad)")
p_gndvi <- d4h_plot(r_gndvi_cal, palette = "viridis", limits = c(0, 0.8),
title = "GNDVI Continuo (Clorofila en Canopia Densa)")
p_dvi <- d4h_plot(r_dvi_cal, palette = "viridis", limits = c(-0.1, 0.6),
title = "DVI Calibrado (Reflectancia)")
# Temperatura relativa (paleta magma)
p_t_rel <- d4h_plot(r_t_rel, palette = "magma", limits = c(0, 1),
title = "Índice Térmico Relativo (0-1)")
# Visualización
print(p_ndwi)
print(p_gndvi)
print(p_dvi)
print(p_t_rel)
